# Ejemplo de configuración para DDD
# Copia este archivo como .env.example.ddd

APP_NAME="Whistleblower DDD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whistleblower_ddd
DB_USERNAME=root
DB_PASSWORD=

# Laravel Settings
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# DDD Module: Whistleblowing
# Configuraciones específicas del módulo si las necesitas
WHISTLEBLOWING_ANONYMOUS_ALLOWED=true
WHISTLEBLOWING_MIN_TITLE_LENGTH=5
WHISTLEBLOWING_MIN_DESCRIPTION_LENGTH=20
